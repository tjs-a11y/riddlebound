# Riddlebound backend. Set these in the host's secret settings (Vercel → Settings → Environment Variables). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Server-only secret used to hash puzzle answers (HMAC-SHA256). 32+ random bytes, e.g. `openssl rand -base64 48`.
# Changing it invalidates every stored answer hash, so set it once.
RIDDLEBOUND_ANSWER_PEPPER=
# RESTRICTED key (rk_live_...): Checkout Sessions, Customers, Customer portal = Write; Prices, Products, Subscriptions = Read. Nothing else.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared rate-limit counters (Vercel KV / Upstash). Without them, limits are per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Lifetime of the signed content link returned after an unlock, in seconds (60-3600).
UNLOCK_URL_TTL_SECONDS=300
# Optional. Where readers land after checkout and the portal (default https://riddlebound.app).
RIDDLEBOUND_SITE_URL=
# Optional. Browser origins allowed to call the API (default https://riddlebound.app,https://www.riddlebound.app).
RIDDLEBOUND_SITE_ORIGINS=
# Optional. Book ids sold one at a time ($5.99, lookup key riddlebound__book__once), comma-separated. Empty = none on sale.
RIDDLEBOUND_BOOKS_FOR_SALE=
